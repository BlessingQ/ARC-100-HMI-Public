# ARC-100 시리얼 고정 이름: /dev/rs485-modbus, rs485-ioc, rs485-inverter (RS-485 3회선) + /dev/rs232-weather (기상대 RS-232)
# ch3 인버터 회선에 HM-100 #2(ID 1)를 같이 물린다 (인버터 국번 21·22·23 과 충돌 없음). 예전 4회선 구성의 rs485-hm100b 는 D 블록.
#
# arc100-list-serial 로 실제 컨버터의 serial / 인터페이스 번호 / ID_PATH 를 확인한 뒤
# 아래 자리표시자(<SERIAL>, <PATH_CHx>)를 채우고 앞의 # 을 지운다. 쓰지 않는 블록은 그대로 둔다.
# 적용: sudo udevadm control --reload-rules && sudo udevadm trigger && ls -l /dev/rs485-*
#
# A. FTDI 다채널 컨버터 (칩 고유 serial 있음) — 권장. 인터페이스 00~02 = ch1~ch3
#SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{serial}=="<SERIAL>", ENV{ID_USB_INTERFACE_NUM}=="00", SYMLINK+="rs485-modbus",   MODE="0660", GROUP="dialout"
#SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{serial}=="<SERIAL>", ENV{ID_USB_INTERFACE_NUM}=="01", SYMLINK+="rs485-ioc",      MODE="0660", GROUP="dialout"
#SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{serial}=="<SERIAL>", ENV{ID_USB_INTERFACE_NUM}=="02", SYMLINK+="rs485-inverter", MODE="0660", GROUP="dialout"
#
# B. serial 이 없는 컨버터(CH340 등) — USB 물리 포트 경로로 고정. 포트를 바꿔 꽂으면 이름이 바뀐다.
#SUBSYSTEM=="tty", ENV{ID_PATH}=="<PATH_CH1>", SYMLINK+="rs485-modbus",   MODE="0660", GROUP="dialout"
#SUBSYSTEM=="tty", ENV{ID_PATH}=="<PATH_CH2>", SYMLINK+="rs485-ioc",      MODE="0660", GROUP="dialout"
#SUBSYSTEM=="tty", ENV{ID_PATH}=="<PATH_CH3>", SYMLINK+="rs485-inverter", MODE="0660", GROUP="dialout"
#
# C. 외부 기상대 (스펙트럼 WatchDog 3250DR, AUX RS-232 9600) — 별도 USB-RS232 컨버터. serial 이 있으면 A 방식, 없으면 ID_PATH.
#SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{serial}=="<SERIAL_WX>", SYMLINK+="rs232-weather", MODE="0660", GROUP="dialout"
#SUBSYSTEM=="tty", ENV{ID_PATH}=="<PATH_WX>", SYMLINK+="rs232-weather", MODE="0660", GROUP="dialout"
#
# D. (예전 4회선 구성) HM-100 #2 를 별도 회선에 둘 때만. site.json 의 buses.hm100b 와 hm100[1].bus="hm100b" 도 함께 필요.
#SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{serial}=="<SERIAL>", ENV{ID_USB_INTERFACE_NUM}=="03", SYMLINK+="rs485-hm100b",   MODE="0660", GROUP="dialout"
